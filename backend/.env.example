PORT=4000
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Scheduler <your-ethereal-user@ethereal.email>
# Use SMTP by default. Set EMAIL_PROVIDER=resend only after verifying a Resend domain.
EMAIL_PROVIDER=smtp
# Optional Resend delivery. RESEND_FROM must use a domain verified at resend.com/domains.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Scheduler <no-reply@your-verified-domain.com>
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=1000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed to call this API. Add your Vercel URL for production.
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# Optional JSON array for multiple Ethereal accounts. Each item: {"email":"sender@example.test","host":"smtp.ethereal.email","port":587,"user":"...","pass":"..."}
SMTP_ACCOUNTS_JSON=[]
